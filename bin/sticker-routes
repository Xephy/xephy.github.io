def load_map(map_id):
    return rmarshal.load(os.path.join(rm.GAME, 'Data', f'Map{map_id:03d}.rxdata')).data


def solved_switches(map_ids):
    """その地図のイベントが ON にするスイッチ。騎乗のスイッチは除く (探索の状態で持つ)。"""
    out = set()
    for mid in map_ids:
        for ev in load_map(mid)['@events'].values():
            for pg in ev.data['@pages']:
                for c in pg.data['@list']:
                    p = c.data['@parameters']
                    if c.data['@code'] == 121 and p[2] == 0:
                        out.update(range(p[0], p[1] + 1))
    out.discard(RIDING)
    return out


def active_page(pages, switches, self_on=False):
    """self_on は、セルフスイッチを ON として扱うか。岩を砕いた・アイテムを拾った・
    トレーナーに勝った、といった「その場で済ませた」状態はセルフスイッチで表される。"""
    for pg in reversed(pages):
        c = pg.data['@condition'].data
        if c.get('@switch1_valid') and c['@switch1_id'] not in switches:
            continue
        if c.get('@switch2_valid') and c['@switch2_id'] not in switches:
            continue
        if c.get('@variable_valid'):
            continue
        if c.get('@self_switch_valid') and not self_on:
            continue
        return pg
    return None


def removable(page):
    """その場で消せる障害物。いあいぎりの木 (Kernel.pbCut) といわくだきの岩
    (Kernel.pbRockSmash)。使うと pbEraseThisEvent で一時的に消えるものと、
    スイッチを立てて消えるもの (地下鉄道網の岩など) がある。どちらも、
    道を探すときは消して通れるものとして扱う。"""
    script = ' '.join(str(c.data['@parameters']) for c in page.data['@list'])
    return 'pbCut' in script or 'pbRockSmash' in script


def smashed_switches(map_ids):
    """いわくだき・いあいぎりのページが立てるスイッチ。岩を砕くとスイッチが立ち、
    同じイベントの次のページが通り道 (扉など) に変わるものがある。"""
    out = set()
    for mid in map_ids:
        for ev in load_map(mid)['@events'].values():
            for pg in ev.data['@pages']:
                if not removable(pg):
                    continue
                for c in pg.data['@list']:
                    q = c.data['@parameters']
                    if c.data['@code'] == 121 and q[2] == 0:
                        out.update(range(q[0], q[1] + 1))
    return out


class Layer:
    def __init__(self, map_id, switches, self_on=False):
        m = load_map(map_id)
        self.map_id = map_id
        self.xs, self.ys, self.zs, self.cells = rm.table(m['@data'])
        ts = rmarshal.load(os.path.join(rm.GAME, 'Data', 'Tilesets.rxdata'))[m['@tileset_id']].data
        self.pas = rm.table(ts['@passages'])[3]
        self.pri = rm.table(ts['@priorities'])[3]
        self.tag = rm.table(ts['@terrain_tags'])[3]
        self.ev = {}
        self.doors = {}   # (x, y) -> [(行き先の地図, x, y)]  騎乗していないときのもの
        for riding in (False, True):
            sw = set(switches) | ({RIDING} if riding else set())
            evs = []
            for e in (x.data for x in m['@events'].values()):
                pg = active_page(e['@pages'], sw, self_on)
                if pg is None:
                    continue
                if removable(pg):
                    continue
                g = pg.data['@graphic'].data
                evs.append((e['@x'], e['@y'], g.get('@tile_id', 0), g.get('@character_name') or '',
                            pg.data.get('@through', False)))
                # 場所移動 (コマンド201、行き先を直接指定したもの)。調べる・触れるで起きるものだけ。
                # 自動実行・並列処理は地図に入ったとたんに動く演出なので道には数えない。
                if not riding and pg.data['@trigger'] in (0, 1, 2):
                    for c in pg.data['@list']:
                        q = c.data['@parameters']
                        if c.data['@code'] == 201 and q[0] == 0:
                            self.doors.setdefault((e['@x'], e['@y']), []).append((q[1], q[2], q[3]))
            self.ev[riding] = evs

    def valid(self, x, y):
        return 0 <= x < self.xs and 0 <= y < self.ys

    def tile(self, x, y, z):
        return self.cells[x + y * self.xs + z * self.xs * self.ys]

    def terrain(self, x, y):
        for z in (2, 1, 0):
            t = self.tag[self.tile(x, y, z)]
            if t > 0:
                return t
        return 0

    def passable(self, x, y, d, riding, facing_tag):
        bit = (1 << (d // 2 - 1)) & 0x0f if d else 0
        for (ex, ey, tid, _cn, th) in self.ev[riding]:
            if ex == x and ey == y and not th and tid >= 0:
                if self.pas[tid] & bit or self.pas[tid] & 0x0f == 0x0f:
                    return False
                if self.pri[tid] == 0:
                    return True
        for z in (2, 1, 0):
            tid = self.tile(x, y, z)
            if riding and facing_tag == TALLGRASS:
                return False
            if self.pas[tid] & bit or self.pas[tid] & 0x0f == 0x0f:
                return False
            if self.pri[tid] == 0:
                return True
        return True

    def occupied(self, x, y, riding):
        return any(ex == x and ey == y and not th and cn for (ex, ey, _t, cn, th) in self.ev[riding])


class World:
    def __init__(self, parts, switches):
        self.parts = [(Layer(mid, switches), ox, oy) for mid, ox, oy in parts]

    def at(self, X, Y):
        for layer, ox, oy in self.parts:
            if layer.valid(X - ox, Y - oy):
                return layer, X - ox, Y - oy
        return None, 0, 0

    def moves(self, X, Y, riding):
        here, x, y = self.at(X, Y)
        for d, (dx, dy) in DIRS.items():
            there, nx, ny = self.at(X + dx, Y + dy)
            if there is None:
                continue
            ftag = there.terrain(nx, ny)
            if not here.passable(x, y, d, riding, ftag) or not there.passable(nx, ny, 10 - d, riding, ftag):
                continue
            if there.occupied(nx, ny, riding):
                continue
            if ftag == LEDGE:
                land, lx, ly = self.at(X + 2 * dx, Y + 2 * dy)
                if land is not None and land.passable(lx, ly, 0, riding, None) and not land.occupied(lx, ly, riding):
                    yield (X + 2 * dx, Y + 2 * dy), 'jump'
                continue
            yield (X + dx, Y + dy), 'walk'


def search(world, starts, goal, riding):
    """状態は (x, y, 騎乗中か)。騎乗中はいつでも降りられ、乗り直せない。
    着いたとするのは、目標のマスの上下左右 (アイテムやイベントは隣から調べる)。"""
    goals = {(goal[0] + dx, goal[1] + dy) for dx, dy in DIRS.values()}
    first = [(x, y, riding) for x, y in starts]
    prev = {s: None for s in first}
    q = collections.deque(first)
    while q:
        cur = q.popleft()
        X, Y, r = cur
        if (X, Y) in goals:
            path = []
            c = (X, Y, r)
            while c is not None:
                path.append(c)
                c = prev[c][0] if prev[c] else None
            path.reverse()
            return path, [prev[p][1] for p in path[1:]]
        nxt = [((p[0], p[1], r), k) for p, k in world.moves(X, Y, r)]
        if r:
            nxt.append(((X, Y, False), 'dismount'))
        for n, k in nxt:
            if n not in prev:
                prev[n] = (cur, k)
                q.append(n)
    return None, None


class Atlas:
    """扉・階段・エレベーターでつながった地図をまたいで歩く (騎乗しない)。

    扉などの移動イベントは、隣のマスからそちらへ進もうとする (触れる) か、向いて
    調べると、行き先へ飛ぶ。RMXP では通れないマスでも「触れる」は起きる。
    使ってよい地図を maps で絞る (町じゅうの扉をたどって広がらないように)。
    """
    def __init__(self, maps, switches, self_on=True):
        switches = set(switches) | smashed_switches(maps)
        self.layers = {mid: Layer(mid, switches, self_on) for mid in maps}

    def moves(self, mid, x, y):
        L = self.layers[mid]
        for d, (dx, dy) in DIRS.items():
            nx, ny = x + dx, y + dy
            if not L.valid(nx, ny):
                continue
            for dest in L.doors.get((nx, ny), []):
                if dest[0] in self.layers:
                    yield dest, 'door'
            ftag = L.terrain(nx, ny)
            if not L.passable(x, y, d, False, ftag) or not L.passable(nx, ny, 10 - d, False, ftag):
                continue
            if L.occupied(nx, ny, False):
                continue
            if ftag == LEDGE:
                lx, ly = x + 2 * dx, y + 2 * dy
                if L.valid(lx, ly) and L.passable(lx, ly, 0, False, None) and not L.occupied(lx, ly, False):
                    yield (mid, lx, ly), 'jump'
                continue
            yield (mid, nx, ny), 'walk'


def search_atlas(atlas, start, goal):
    """start = (地図, x, y)。goal = (地図, x, y) で、その上下左右に着けばよい。"""
    gmid, gx, gy = goal
    goals = {(gmid, gx + dx, gy + dy) for dx, dy in DIRS.values()}
    prev = {start: None}
    q = collections.deque([start])
    while q:
        cur = q.popleft()
        if cur in goals:
            path = []
            c = cur
            while c is not None:
                path.append(c)
                c = prev[c][0] if prev[c] else None
            path.reverse()
            return path, [prev[p][1] for p in path[1:]]
        for n, k in atlas.moves(*cur):
            if n not in prev:
                prev[n] = (cur, k)
                q.append(n)
    return None, None


def stages(path, kinds):
    """段差を飛ぶところで区切る。各区切りは (始まり, 終わり) の path の番号。"""
    cuts = [0] + [i + 1 for i, k in enumerate(kinds) if k == 'jump'] + [len(path) - 1]
    return [(a, b) for a, b in zip(cuts, cuts[1:]) if b > a]


def corners(points):
    out = [points[0]]
    for a, b, c in zip(points, points[1:], points[2:]):
        if (b[0] - a[0], b[1] - a[1]) != (c[0] - b[0], c[1] - b[1]):
            out.append(b)
    out.append(points[-1])
    return out


def draw_route(img, origin, pts, width, color, halo=True):
    d = ImageDraw.Draw(img, 'RGBA')
    xy = [((p[0] - origin[0]) * T + T // 2, (p[1] - origin[1]) * T + T // 2) for p in corners(pts)]
    if halo:
        d.line(xy, fill=(255, 255, 255, 235), width=width + 6, joint='curve')
    d.line(xy, fill=color, width=width, joint='curve')


def draw_mark(img, origin, p, label, color, r=22):
    d = ImageDraw.Draw(img, 'RGBA')
    x, y = (p[0] - origin[0]) * T + T // 2, (p[1] - origin[1]) * T + T // 2
    d.ellipse([x - r, y - r, x + r, y + r], fill=color, outline=(255, 255, 255, 255), width=4)
    d.text((x, y + 1), label, fill=(255, 255, 255, 255), font=ImageFont.load_default(size=int(r * 1.35)), anchor='mm')


def draw_target(img, origin, p, label, color):
    """話しかける相手・拾うもの。番号の丸で隠さず、マスを枠で囲んで番号は右上に出す。
    人物の画像は1マスより背が高いので、枠は上に半マス伸ばす。"""
    d = ImageDraw.Draw(img, 'RGBA')
    x, y = (p[0] - origin[0]) * T, (p[1] - origin[1]) * T
    d.rounded_rectangle([x - 4, y - T // 2 - 4, x + T + 4, y + T + 4], radius=6,
                        outline=(255, 255, 255, 255), width=7)
    d.rounded_rectangle([x - 4, y - T // 2 - 4, x + T + 4, y + T + 4], radius=6, outline=color, width=4)
    draw_mark(img, (origin[0] - 0.9, origin[1] + 0.9), p, label, color, r=17)


BLUE, ORANGE, RED = (30, 110, 220, 255), (240, 140, 0, 255), (230, 40, 40, 255)
# 段階の図で、ほかの段階の道を示す線。縁取りを付けず白で薄く引き、今の段階の赤と見分ける。
FAINT = (255, 255, 255, 150)


def box(points, margin, lo, hi):
    xs = [p[0] for p in points]
    ys = [p[1] for p in points]
    return (max(lo[0], min(xs) - margin), max(lo[1], min(ys) - margin),
            min(hi[0], max(xs) + margin + 1), min(hi[1], max(ys) + margin + 1))


def build(name, spec):
    sw = solved_switches(spec['solved'])
    world = World(spec['parts'], sw)
    path, kinds = search(world, spec['start'], spec['goal'], spec['riding'])
    if path is None:
        sys.exit(f'{name}: 道が見つからない')
    pts = [(p[0], p[1]) for p in path]
    lo = (min(ox for _m, ox, _y in spec['parts']), 0)
    hi = (max(ox + L.xs for (L, ox, _y) in world.parts), max(oy + L.ys for (L, _x, oy) in world.parts))
    marks = [pts[0]] + [((pts[a - 1][0] + pts[a][0]) / 2, (pts[a - 1][1] + pts[a][1]) / 2)
                        for a, _b in stages(pts, kinds)[1:]] + [spec['goal']]

    def mark_all(img, origin, only=None):
        for i, p in enumerate(marks):
            if only is not None and i not in only:
                continue
            color = BLUE if i == 0 else RED if i == len(marks) - 1 else ORANGE
            draw_mark(img, origin, p, str(i + 1), color)

    files = []
    # 全体図
    x0, y0, x1, y1 = box(pts + [spec['goal']], 3, lo, hi)
    img = rm.render_world(spec['parts'], (x0, y0, x1, y1))
    draw_route(img, (x0, y0), pts, 7, RED)
    mark_all(img, (x0, y0))
    files.append(save(img, f'{name}-route.webp'))
    # 段階ごとの図。道全体を薄く、その段階だけを濃く描く
    for n, (a, b) in enumerate(stages(pts, kinds), 1):
        seg = pts[max(a - 1, 0):b + 1]
        x0, y0, x1, y1 = box(seg + ([spec['goal']] if b == len(pts) - 1 else []), 4, lo, hi)
        img = rm.render_world(spec['parts'], (x0, y0, x1, y1))
        draw_route(img, (x0, y0), pts, 4, FAINT, halo=False)
        draw_route(img, (x0, y0), seg, 7, RED)
        mark_all(img, (x0, y0), only={n - 1, n})
        files.append(save(img, f'{name}-step{n}.webp'))
    if 'entrance' in spec:
        e = spec['entrance']
        x0, y0, x1, y1 = e['crop']
        img, _ = rm.render(e['map'], crop=e['crop'])
        draw_mark(img, (x0, y0), e['at'], '1', BLUE)
        files.insert(0, save(img, f'{name}-entrance.webp'))
    walk = sum(1 for k in kinds if k != 'dismount')
    print(f'{name}: {walk}歩 段差{kinds.count("jump")}回 '
          f'{"降りる" if "dismount" in kinds else "降りない"} / {len(files)}枚')
    for f in files:
        print('   ', os.path.relpath(f, ROOT))


def split_by_door(path, kinds):
    """扉を通るところで区切る。1枚の地図の中で別の場所へ飛ぶ扉 (建物の中の階段や
    部屋の扉) もあるので、地図が変わるかどうかではなく扉で区切る。
    [(地図, [(x, y), ...]), ...]"""
    segs = [(path[0][0], [path[0][1:]])]
    for p, kind in zip(path[1:], kinds):
        if kind == 'door':
            segs.append((p[0], []))
        segs[-1][1].append(p[1:])
    return segs


def trim_black(img, pad=1):
    """建物の中の地図は周りが真っ黒なことが多い。黒い余白を詰める (1マス残す)。"""
    rgb = img.convert('RGB')
    bbox = Image.eval(rgb, lambda v: 255 if v > 12 else 0).getbbox()
    if not bbox:
        return img
    x0, y0, x1, y1 = bbox
    x0, y0 = max(0, x0 - pad * T), max(0, y0 - pad * T)
    x1, y1 = min(img.width, x1 + pad * T), min(img.height, y1 + pad * T)
    return img.crop((x0, y0, x1, y1)), (x0 // T, y0 // T)


def build_spot(name, leg):
    """道順ではなく、場所の印だけの図。"""
    mid, marks = leg['spot'], leg['marks']
    m = load_map(mid)
    x0, y0, x1, y1 = box(marks, 6, (0, 0), (m['@width'], m['@height']))
    img, _ = rm.render(mid, crop=(x0, y0, x1, y1))
    for i, p in enumerate(marks):
        draw_target(img, (x0, y0), p, str(i + 1), RED if i == len(marks) - 1 else ORANGE)
    f = save(img, f"{name}-{leg['id']}.webp")
    print(f"{name}-{leg['id']}: 位置の図 {marks}")
    return [f]


def build_leg(name, leg):
    """扉をたどる道順を、地図ごとの図にする。

    番号は、出発を1、扉を1つ通るごとに1つずつ、着く先を最後にする。扉の番号は、
    入る扉と、次の区間で出てくる位置の両方に付ける。

    同じ地図の中で続いている区間 (建物の中の階段で別の場所へ飛ぶものなど) は、
    まとめても図が大きくなりすぎなければ1枚にする。飛ぶ前と後は線をつながない。
    数マスしか歩かない区間と、細長すぎて読めない区間は図にせず番号だけ進める
    (説明の文で補う)。
    """
    atlas = Atlas(leg['maps'], solved_switches(leg['solved']), leg.get('self_on', True))
    path, kinds = search_atlas(atlas, leg['start'], leg['goal'])
    if path is None:
        sys.exit(f"{name}-{leg['id']}: 道が見つからない")
    segs = split_by_door(path, kinds)
    targets = [leg['goal'][1:]]
    if 'then' in leg:                       # 着いたあと、同じ場所で続けて話しかける相手
        p2, k2 = search_atlas(atlas, path[-1], leg['then'])
        if p2 is None or 'door' in k2:
            sys.exit(f"{name}-{leg['id']}: then に届かない")
        segs[-1][1].extend(q[1:] for q in p2[1:])
        targets.append(leg['then'][1:])

    # 区間ごとに、線の終わり (扉のマス、または着く先) と番号を決める
    items, number = [], 1
    for k, (mid, pts) in enumerate(segs):
        L = atlas.layers[mid]
        last = k == len(segs) - 1
        end = None
        if not last:
            nmid, npts = segs[k + 1]
            for d, (dx, dy) in DIRS.items():
                cand = (pts[-1][0] + dx, pts[-1][1] + dy)
                if any(t[0] == nmid and (t[1], t[2]) == npts[0] for t in L.doors.get(cand, [])):
                    end = cand
                    break
        items.append({'map': mid, 'pts': pts, 'end': end or pts[-1], 'last': last,
                      'num': number, 'first': k == 0})
        number += 1

    def dims(group):
        xs = [p[0] for it in group for p in it['pts'] + [it['end']]]
        ys = [p[1] for it in group for p in it['pts'] + [it['end']]]
        return max(xs) - min(xs) + 1, max(ys) - min(ys) + 1

    groups = []
    for it in items:
        g = groups[-1] if groups else None
        if g and g[0]['map'] == it['map']:
            w, h = dims(g + [it])
            if w <= 45 and h <= 26:
                g.append(it)
                continue
        groups.append([it])

    files = []
    for g in groups:
        w, h = dims(g)
        tiles = sum(len(it['pts']) for it in g)
        has_last = any(it['last'] for it in g)
        if not has_last and not g[0]['first'] and (tiles < 5 or h > 4 * max(w, 6)):
            print(f"   map{g[0]['map']}: 図にしない ({tiles}マス, {w}x{h})  番号{g[0]['num']}→{g[-1]['num'] + 1}")
            continue
        mid = g[0]['map']
        L = atlas.layers[mid]
        allp = [p for it in g for p in it['pts'] + [it['end']]] + (targets if has_last else [])
        x0, y0, x1, y1 = box(allp, 4, (0, 0), (L.xs, L.ys))
        img, _ = rm.render(mid, crop=(x0, y0, x1, y1))
        img, (tx, ty) = trim_black(img)
        x0, y0 = x0 + tx, y0 + ty
        for it in g:
            draw_route(img, (x0, y0), it['pts'] + ([] if it['last'] else [it['end']]), 7, RED)
        for it in g:
            draw_mark(img, (x0, y0), it['pts'][0], str(it['num']), BLUE if it['first'] else ORANGE)
            if not it['last']:
                draw_mark(img, (x0, y0), it['end'], str(it['num'] + 1), ORANGE)
        if has_last:
            n = g[-1]['num'] + 1
            for i, t in enumerate(targets):
                draw_target(img, (x0, y0), t, str(n + i), RED)
        files.append(save(img, f"{name}-{leg['id']}-{len(files) + 1}.webp"))
        print(f"   map{mid}: 図{len(files)} 区間{len(g)}つ {tiles}マス  番号{g[0]['num']}→{g[-1]['num'] + 1}"
              + (f"〜{g[-1]['num'] + len(targets)}" if has_last else ''))
    print(f"{name}-{leg['id']}: {len(path) - 1}手 扉{kinds.count('door')}回 / {len(files)}枚")
    return files


def save(img, filename):
    os.makedirs(OUT, exist_ok=True)
    path = os.path.join(OUT, filename)
    img.convert('RGB').save(path, lossless=True, method=6)
    return path


def main():
    names = sys.argv[1:] or list(ROUTES) + list(LEGS)
    for name in names:
        if name in ROUTES:
            build(name, ROUTES[name])
        for leg in LEGS.get(name, []):
            (build_spot if 'spot' in leg else build_leg)(name, leg)


if __name__ == '__main__':
    main()
