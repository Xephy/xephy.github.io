#!/usr/bin/env python3
"""ナビの「進行状況」を、ゲームのセーブデータから書き出す。

ナビは章ごとの進行状況で道を探す。どのスイッチが立っているかをイベントのデータから
推し量ることはせず、その時点で実際に取ったセーブデータの値をそのまま使う。
書き出すのは道探しに使うもの (スイッチ・変数・セルフスイッチ・バッジの数・
連れ歩きの有無・条件分岐で調べられる大事なもの) だけで、名前や手持ちは含めない。

  bin/navi-state SAVE.rxdata ch14 "14章を終えたところ"
    → _ja/navi/states/ch14.json
"""
import os
import sys

sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
import navi_engine as ne  # noqa: E402


def main():
    if len(sys.argv) != 4:
        sys.exit(__doc__)
    save, key, label = sys.argv[1:]
    s = ne.State.from_save(save)
    out = os.path.join(ne.ROOT, '_ja', 'navi', 'states', f'{key}.json')
    os.makedirs(os.path.dirname(out), exist_ok=True)
    s.dump(out, label)
    print(f'{out}: スイッチ {len(s.switches)} / 変数 {len(s.vars)} / バッジ {s.badges}')


if __name__ == '__main__':
    main()
