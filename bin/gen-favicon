#!/usr/bin/env python3
"""ブラウザのタブに出す favicon を作る。

元は上流 (BIGJRA) の "B" ロゴだった。日本語版なのでサイトの主色
(#2b6cb0) の角丸に白の「リ」を置いたものに差し替える。

大きく描いてから縮めるのは、16px で直接描くと輪郭が潰れるため。字の
大きさ 0.88 は、16px でも二画が分かれて見える上限として実測で決めた。
"""
from pathlib import Path

from PIL import Image, ImageDraw, ImageFont

CANVAS = 512
GLYPH = 'リ'
GLYPH_RATIO = 0.88
CORNER_RATIO = 0.22
BLUE = (43, 108, 176, 255)      # style.scss で最も使われている青
WHITE = (255, 255, 255, 255)
SIZES = [16, 32, 48]
FONT = Path.home() / '.local/share/fonts/NotoSansCJKjp-Bold.otf'
DEST = Path(__file__).resolve().parent.parent / 'src' / 'favicon.ico'


def main():
    if not FONT.exists():
        raise SystemExit(f'フォントが見つかりません: {FONT}')

    im = Image.new('RGBA', (CANVAS, CANVAS), (0, 0, 0, 0))
    d = ImageDraw.Draw(im)
    d.rounded_rectangle([0, 0, CANVAS - 1, CANVAS - 1],
                        radius=int(CANVAS * CORNER_RATIO), fill=BLUE)

    font = ImageFont.truetype(str(FONT), int(CANVAS * GLYPH_RATIO))
    box = d.textbbox((0, 0), GLYPH, font=font)
    d.text(((CANVAS - (box[2] - box[0])) / 2 - box[0],
            (CANVAS - (box[3] - box[1])) / 2 - box[1]),
           GLYPH, font=font, fill=WHITE)

    im.save(DEST, format='ICO', sizes=[(s, s) for s in SIZES])
    print(f'  {DEST.name}: {", ".join(f"{s}x{s}" for s in SIZES)} '
          f'({DEST.stat().st_size} バイト)')


if __name__ == '__main__':
    main()
